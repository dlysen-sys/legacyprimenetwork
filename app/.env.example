# LegacyPrime frontend env. Copy to .env (gitignored). All CLIENT vars must be VITE_-prefixed;
# never put secrets (private keys, PATs) in VITE_ vars — they are bundled into the client build.

# Base path for the build (default '/'). Set for a subpath deploy, e.g. '/legacyprime/'.
VITE_BASE_URL=/

# Reown AppKit project id (dashboard.reown.com) — enables WalletConnect / QR connect.
# Injected wallets (MetaMask) work without it. Client var, safe to expose.
VITE_REOWN_PROJECT_ID=

# --- Contract integration (LegacyPrime plan) ---
# Set once the plan is deployed. One address covers the active chain; per-chain overrides optional.
VITE_LEGACYPRIME_ADDRESS=
# VITE_LEGACYPRIME_ADDRESS_BSC=       # 56  mainnet override
# VITE_LEGACYPRIME_ADDRESS_TESTNET=   # 97  testnet override
# VITE_LEGACYPRIME_ADDRESS_LOCAL=     # 31337 anvil override

# USDT token (18dp). Defaults to BSC mainnet USDT (matches the plan's hardcoded token). Override for
# testnet/local. VITE_LPNT_ADDRESS defaults to the deployed LPN TOKEN.
# VITE_USDT_ADDRESS=
# VITE_USDT_ADDRESS_TESTNET=
# VITE_USDT_ADDRESS_LOCAL=
# VITE_LPNT_ADDRESS=

# Swap link (USDT ⇄ LPNT). Defaults to a PancakeSwap deep-link; set to your own swap page when ready.
# VITE_SWAP_URL=
